modules = ["nodejs-20", "web", "python-3.12", "ruby-3.2"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Jekyll Server"

[[workflows.workflow]]
name = "Jekyll Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bundle exec jekyll serve --config _config.yml,_config_dev.yml --watch"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 32909
externalPort = 3000

[deployment]
deploymentTarget = "autoscale"
run = ["bundle", "exec", "jekyll", "serve", "--config", "_config.yml", "--host", "0.0.0.0", "--port", "5000"]
build = ["bundle", "exec", "jekyll", "build", "--config", "_config.yml"]
